# Copy this file to .env and fill in your values

# Server
PORT=3000

# Database — choose one:
# Option A: SQLite (simple, no setup needed)
DB_DIALECT=sqlite
DB_STORAGE=./db/gaming_stats.sqlite

# Option B: PostgreSQL (uncomment and fill in)
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gaming_stats
# DB_USER=gaming_user
# DB_PASSWORD=gaming_pass123
